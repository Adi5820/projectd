# ==========================================
# Agentic Ads - Backend Environment Configuration
# ==========================================

# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=agentic_ads

# AI Provider API Keys
# Google Gemini API key (Required for Campaign orchestration and Ad Copy generation)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Together AI API key (Required for FLUX / SDXL image generation & fast open models)
TOGETHER_API_KEY=your_together_ai_api_key_here

# Stability AI API key (Optional alternative for image generation)
STABILITY_API_KEY=

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Storage & Persistence
MEDIA_STORAGE_PATH=./media
CHROMA_PERSIST_DIR=./chroma_db

# Security & Secrets
SECRET_KEY=agentic-ads-super-secure-secret-key-change-in-production-2026

# Generation Rate Limits & Constraints
MAX_GENERATIONS_PER_HOUR=20
MAX_UPLOAD_SIZE_MB=10
MAX_VIDEO_DURATION_SECONDS=60

# Voice Synthesis (Edge-TTS Microsoft Neural Voices)
# Options: en-US-AriaNeural, en-US-GuyNeural, en-GB-SoniaNeural, en-AU-NatashaNeural, etc.
EDGE_TTS_VOICE=en-US-AriaNeural
